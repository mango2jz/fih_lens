<Window
    x:Class="FihLens.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FIH Lens Translator">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24" MaxWidth="1000" HorizontalAlignment="Center" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="English to Vietnamese" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Translate a sentence and review its learning notes." Opacity="0.75" />
                <TextBlock Text="{x:Bind ViewModel.ModeDescription, Mode=OneWay}" Opacity="0.75" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="8">
                <TextBlock Text="English text" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBox x:Name="InputBox" Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{x:Bind ViewModel.IsEditingEnabled, Mode=OneWay}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110"
                         PlaceholderText="Enter English text" AutomationProperties.Name="English text" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Content="Translate" Command="{x:Bind ViewModel.TranslateCommand, Mode=OneWay}" />
                <Button Content="Cancel" Command="{x:Bind ViewModel.TranslateCancelCommand, Mode=OneWay}" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              Width="28" Height="28"
                              AutomationProperties.Name="Translation in progress" />
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Assertive" />

            <StackPanel Grid.Row="4" Spacing="12">
                <TextBlock Text="Original text" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBox Text="{x:Bind ViewModel.Result.OriginalText, Mode=OneWay}" IsReadOnly="True"
                         TextWrapping="Wrap" MinHeight="60" IsTabStop="True" />
                <TextBlock Text="Vietnamese translation" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBox Text="{x:Bind ViewModel.Result.NaturalTranslation, Mode=OneWay}" IsReadOnly="True"
                         TextWrapping="Wrap" MinHeight="70" IsTabStop="True" />
                <TextBlock Text="Explanation" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBox Text="{x:Bind ViewModel.Result.Explanation, Mode=OneWay}" IsReadOnly="True"
                         TextWrapping="Wrap" MinHeight="50" IsTabStop="True" />
                <TextBlock Text="Vocabulary" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Result.Vocabulary, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4" Spacing="2">
                                <TextBlock Text="{Binding Word}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding PartOfSpeech}" Opacity="0.75" />
                                <TextBlock Text="{Binding Meaning}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ExampleSentence}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Grammar" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Result.Grammar, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4" Spacing="2">
                                <TextBlock Text="{Binding Pattern}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ExampleSentence}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Alternative translations" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Result.Alternatives, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4" Spacing="2">
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
