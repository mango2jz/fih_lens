<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="Phase1SurfaceBrush" Color="#FAFAFA" />
      <SolidColorBrush x:Key="Phase1TextBrush" Color="#1A1A1A" />
      <SolidColorBrush x:Key="Phase1SecondaryBrush" Color="#595959" />
      <SolidColorBrush x:Key="Phase1BorderBrush" Color="#D1D1D1" />
      <SolidColorBrush x:Key="Phase1SubtleBrush" Color="#F0F0F0" />
      <SolidColorBrush x:Key="Phase1AccentBrush" Color="#005FB8" />
      <SolidColorBrush x:Key="Phase1AccentSoftBrush" Color="#E5F1FB" />
      <SolidColorBrush x:Key="Phase1OnAccentBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Phase1SuccessBrush" Color="#0F6B3A" />
      <SolidColorBrush x:Key="Phase1SuccessSoftBrush" Color="#E8F5ED" />
      <SolidColorBrush x:Key="Phase1ErrorBrush" Color="#A4262C" />
      <SolidColorBrush x:Key="Phase1ErrorSoftBrush" Color="#FDEBED" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="Phase1SurfaceBrush" Color="#2C2C2C" />
      <SolidColorBrush x:Key="Phase1TextBrush" Color="#F5F5F5" />
      <SolidColorBrush x:Key="Phase1SecondaryBrush" Color="#C5C5C5" />
      <SolidColorBrush x:Key="Phase1BorderBrush" Color="#606060" />
      <SolidColorBrush x:Key="Phase1SubtleBrush" Color="#383838" />
      <SolidColorBrush x:Key="Phase1AccentBrush" Color="#60CDFF" />
      <SolidColorBrush x:Key="Phase1AccentSoftBrush" Color="#153E52" />
      <SolidColorBrush x:Key="Phase1OnAccentBrush" Color="#002B40" />
      <SolidColorBrush x:Key="Phase1SuccessBrush" Color="#8AD5A6" />
      <SolidColorBrush x:Key="Phase1SuccessSoftBrush" Color="#1C3B29" />
      <SolidColorBrush x:Key="Phase1ErrorBrush" Color="#FFB4AB" />
      <SolidColorBrush x:Key="Phase1ErrorSoftBrush" Color="#4C2525" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="Phase1SurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="Phase1TextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="Phase1SecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="Phase1BorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="Phase1SubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="Phase1AccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="Phase1AccentSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="Phase1OnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="Phase1SuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="Phase1SuccessSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="Phase1ErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="Phase1ErrorSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <FontFamily x:Key="Phase1FontFamily">Segoe UI Variable</FontFamily>
  <x:Double x:Key="Phase1Space0">0</x:Double>
  <x:Double x:Key="Phase1Space4">4</x:Double>
  <x:Double x:Key="Phase1Space8">8</x:Double>
  <x:Double x:Key="Phase1Space12">12</x:Double>
  <x:Double x:Key="Phase1Space16">16</x:Double>
  <x:Double x:Key="Phase1PopupWidth">400</x:Double>
  <x:Double x:Key="Phase1IconSize">20</x:Double>
  <x:Double x:Key="Phase1ActionMinHeight">32</x:Double>
  <x:Double x:Key="Phase1TranslationFontSize">17</x:Double>
  <x:Double x:Key="Phase1TranslationLineHeight">26</x:Double>
  <x:Double x:Key="Phase1BodyFontSize">14</x:Double>
  <x:Double x:Key="Phase1BodyLineHeight">21</x:Double>
  <x:Double x:Key="Phase1CaptionFontSize">12</x:Double>
  <x:Double x:Key="Phase1CaptionLineHeight">18</x:Double>
  <x:Double x:Key="Phase1LabelFontSize">13</x:Double>
  <x:Double x:Key="Phase1LabelLineHeight">20</x:Double>
  <x:Double x:Key="Phase1ButtonFontSize">14</x:Double>
  <x:Double x:Key="Phase1ButtonLineHeight">20</x:Double>
  <x:Double x:Key="Phase1TitleFontSize">20</x:Double>
  <x:Double x:Key="Phase1TitleLineHeight">28</x:Double>
  <x:Double x:Key="Phase1ShadowAmbientBlur">3</x:Double>
  <x:Double x:Key="Phase1ShadowAmbientOffsetY">1</x:Double>
  <x:Double x:Key="Phase1ShadowDirectionalBlur">24</x:Double>
  <x:Double x:Key="Phase1ShadowDirectionalOffsetY">8</x:Double>
  <Thickness x:Key="Phase1SurfacePadding">16</Thickness>
  <Thickness x:Key="Phase1ActionPadding">12,0</Thickness>
  <Thickness x:Key="Phase1StatusPadding">8</Thickness>
  <Thickness x:Key="Phase1BorderThickness">1</Thickness>
  <CornerRadius x:Key="Phase1SurfaceCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="Phase1ControlCornerRadius">4</CornerRadius>
  <Color x:Key="Phase1ShadowAmbientColor">#1A000000</Color>
  <Color x:Key="Phase1ShadowDirectionalColor">#33000000</Color>
</ResourceDictionary>
