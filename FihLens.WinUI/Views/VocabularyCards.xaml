<UserControl
    x:Class="FihLens.WinUI.Views.VocabularyCards"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FihLens.WinUI.ViewModels">
  <ItemsControl ItemsSource="{x:Bind Items, Mode=OneWay}">
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="vm:VocabularyCardViewModel">
        <StackPanel Margin="0,6" Spacing="4">
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind Item.Word}" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" VerticalAlignment="Center" />
            <Button Grid.Column="1" Command="{x:Bind Pronunciation.SpeakCommand}" CommandParameter="{x:Bind SpeechText}"
                    AutomationProperties.Name="{x:Bind SpeechAutomationName}" ToolTipService.ToolTip="{x:Bind SpeechHint}">
              <SymbolIcon Symbol="Volume" />
            </Button>
          </Grid>
          <TextBlock Text="{x:Bind Item.Reading}" Visibility="{x:Bind HasReading}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.Name="Japanese reading" />
          <TextBlock Text="{x:Bind Item.Phonetic}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
          <TextBlock Text="{x:Bind Item.PartOfSpeech}" Opacity="0.75" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
          <TextBlock Text="{x:Bind BaseFormText}" Visibility="{x:Bind HasBaseForm}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
          <TextBlock Text="{x:Bind Item.Meaning}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
          <TextBlock Text="{x:Bind SynonymsText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
          <TextBlock Text="{x:Bind SpeechUnavailableReason}" Visibility="{x:Bind HasSpeechUnavailableReason}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="{x:Bind Item.ExampleSentence}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </StackPanel>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
