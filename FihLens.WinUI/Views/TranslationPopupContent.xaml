<UserControl
  x:Class="FihLens.WinUI.Views.TranslationPopupContent"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:views="using:FihLens.WinUI.Views"
  Loaded="Content_Loaded" SizeChanged="Content_SizeChanged"
  MaxWidth="{StaticResource Phase1PopupWidth}"
  HorizontalAlignment="Stretch">
  <UserControl.Resources>
    <Style x:Key="CopiedStatusStyle" TargetType="Border" BasedOn="{StaticResource Phase1StatusStyle}">
      <Setter Property="Background" Value="{ThemeResource Phase1AccentSoftBrush}" />
    </Style>
  </UserControl.Resources>
  <Border x:Name="SnapshotRoot" Style="{StaticResource Phase1SurfaceStyle}" Visibility="Collapsed">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition x:Name="AnswerRow" Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition x:Name="ExpandedRow" Height="0" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid ColumnSpacing="{StaticResource Phase1Space8}" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Phase1Space8}" VerticalAlignment="Center">
          <BitmapIcon Style="{StaticResource Phase1ScanIconStyle}" />
          <TextBlock Text="fih-lens" Style="{StaticResource Phase1LabelTextStyle}" VerticalAlignment="Center" />
          <TextBlock Text="{x:Bind ViewModel.LanguagePairLabel, Mode=OneWay}" Style="{StaticResource Phase1CaptionTextStyle}" VerticalAlignment="Center" />
          <TextBlock Text="Design preview" Visibility="{x:Bind ViewModel.IsPreview, Mode=OneWay}"
                     Style="{StaticResource Phase1CaptionTextStyle}" VerticalAlignment="Center"
                     AutomationProperties.Name="{x:Bind ViewModel.PreviewNotice, Mode=OneWay}"
                     ToolTipService.ToolTip="{x:Bind ViewModel.PreviewNotice, Mode=OneWay}" />
        </StackPanel>
        <Button x:Name="CloseButton" Grid.Column="1" Style="{StaticResource Phase1GhostButtonStyle}"
                Padding="4" MinWidth="28" MinHeight="28"
                Command="{x:Bind ViewModel.CloseCommand, Mode=OneWay}"
                AutomationProperties.Name="Close translation popup" ToolTipService.ToolTip="Close">
          <BitmapIcon Style="{StaticResource Phase1CloseIconStyle}" />
        </Button>
      </Grid>
      <ScrollViewer Grid.Row="1" Margin="0,0,0,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="{StaticResource Phase1Space12}">
          <Border x:Name="StageStatus" Style="{StaticResource Phase1StatusStyle}" Visibility="{x:Bind ViewModel.HasStageStatus, Mode=OneWay}">
          <StackPanel Spacing="12">
            <StackPanel Visibility="{x:Bind ViewModel.IsPreviewStage, Mode=OneWay}" Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <BitmapIcon Style="{StaticResource Phase1ScanIconStyle}" Visibility="{x:Bind ViewModel.IsOcrLoadingPreview, Mode=OneWay}" />
                <BitmapIcon Style="{StaticResource Phase1RetryIconStyle}" Visibility="{x:Bind ViewModel.IsTranslatingPreview, Mode=OneWay}" Foreground="{ThemeResource Phase1AccentBrush}" />
                <BitmapIcon Style="{StaticResource Phase1ErrorIconStyle}" Visibility="{x:Bind ViewModel.IsErrorStatus, Mode=OneWay}" Foreground="{ThemeResource Phase1ErrorBrush}" />
                <TextBlock Text="{x:Bind ViewModel.StageHeading, Mode=OneWay}" Style="{StaticResource Phase1LabelTextStyle}" AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
              <TextBlock Text="{x:Bind ViewModel.StageDescription, Mode=OneWay}" Style="{StaticResource Phase1BodyTextStyle}" />
            </StackPanel>
            <StackPanel Visibility="{x:Bind ViewModel.ShowBackendStatuses, Mode=OneWay}" Spacing="4">
              <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" AutomationProperties.Name="Operation in progress" />
              <TextBlock Text="{x:Bind ViewModel.DictionaryStatus, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasDictionaryStatus, Mode=OneWay}" Style="{StaticResource Phase1CaptionTextStyle}" AutomationProperties.LiveSetting="Polite" />
              <TextBlock Text="{x:Bind ViewModel.AiStatus, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasAiStatus, Mode=OneWay}" Style="{StaticResource Phase1CaptionTextStyle}" AutomationProperties.LiveSetting="Polite" />
              <TextBlock Text="{x:Bind ViewModel.BackendErrorMessage, Mode=OneWay}" Style="{StaticResource Phase1CaptionTextStyle}" AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
          </StackPanel>
          </Border>
          <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.IsProcessingPreview, Mode=OneWay}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.FirstProcessingStep, Mode=OneWay}" Style="{StaticResource Phase1CaptionTextStyle}" Foreground="{ThemeResource Phase1AccentBrush}" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SecondProcessingStep, Mode=OneWay}" Style="{StaticResource Phase1CaptionTextStyle}" />
          </Grid>
          <StackPanel Visibility="{x:Bind ViewModel.IsPreviewStage, Mode=OneWay}" Spacing="4">
            <TextBlock Text="{x:Bind ViewModel.RetainedTextLabel, Mode=OneWay}" Style="{StaticResource Phase1CaptionTextStyle}" />
            <TextBlock Text="{x:Bind ViewModel.RetainedText, Mode=OneWay}" Style="{StaticResource Phase1BodyTextStyle}" Visibility="{x:Bind ViewModel.ShowRetainedText, Mode=OneWay}" />
            <Border Height="8" MaxWidth="336" HorizontalAlignment="Stretch" CornerRadius="4" Background="{ThemeResource Phase1SubtleBrush}" Visibility="{x:Bind ViewModel.IsOcrLoadingPreview, Mode=OneWay}" />
            <Border Height="8" MaxWidth="280" HorizontalAlignment="Stretch" CornerRadius="4" Background="{ThemeResource Phase1SubtleBrush}" Visibility="{x:Bind ViewModel.IsOcrLoadingPreview, Mode=OneWay}" />
          </StackPanel>
          <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.ShowAnswer, Mode=OneWay}">
          <StackPanel Spacing="{StaticResource Phase1Space4}">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind ViewModel.InputLabel, Mode=OneWay}" Style="{StaticResource Phase1CaptionTextStyle}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Command="{x:Bind ViewModel.Pronunciation.SpeakCommand, Mode=OneWay}"
                      CommandParameter="{x:Bind ViewModel.Pronunciation.SourceText, Mode=OneWay}"
                      AutomationProperties.Name="{x:Bind ViewModel.Pronunciation.SourceAutomationName, Mode=OneWay}"
                      ToolTipService.ToolTip="{x:Bind ViewModel.Pronunciation.SourceUnavailableReason, Mode=OneWay}">
                <SymbolIcon Symbol="Volume" />
              </Button>
              <Button Grid.Column="2" Content="Stop" Command="{x:Bind ViewModel.Pronunciation.StopCommand, Mode=OneWay}" AutomationProperties.Name="Stop pronunciation" />
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.OriginalText, Mode=OneWay}" Style="{StaticResource Phase1BodyTextStyle}"
                       AutomationProperties.Name="{x:Bind ViewModel.InputLabel, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.Pronunciation.SourceUnavailableReason, Mode=OneWay}" Style="{StaticResource Phase1CaptionTextStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Pronunciation.Status, Mode=OneWay}" Style="{StaticResource Phase1CaptionTextStyle}" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
          <StackPanel Spacing="{StaticResource Phase1Space4}">
            <TextBlock Text="{x:Bind ViewModel.OutputLabel, Mode=OneWay}" Style="{StaticResource Phase1CaptionTextStyle}" />
            <TextBlock Text="{x:Bind ViewModel.OutputText, Mode=OneWay}" Style="{StaticResource Phase1TranslationTextStyle}"
                       Visibility="{x:Bind ViewModel.HasOutput, Mode=OneWay}" AutomationProperties.Name="Current output" />
            <TextBlock Text="{x:Bind ViewModel.OutputUnavailableReason, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.HasNoOutput, Mode=OneWay}"
                       Style="{StaticResource Phase1BodyTextStyle}" />
          </StackPanel>
          <Border Background="{ThemeResource Phase1AccentSoftBrush}" Padding="{StaticResource Phase1StatusPadding}"
                  CornerRadius="{StaticResource Phase1ControlCornerRadius}"
                  Visibility="{x:Bind ViewModel.HasVocabulary, Mode=OneWay}">
            <views:VocabularyCards Items="{x:Bind ViewModel.WordCards, Mode=OneWay}" AutomationProperties.Name="Provided vocabulary" />
          </Border>
          <TextBlock Text="{x:Bind ViewModel.SourceLabel, Mode=OneWay}" Style="{StaticResource Phase1CaptionTextStyle}"
                     AutomationProperties.Name="Result source" />
          <Expander x:Name="SourceDisclosure" Header="Source and notices" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.SourceDetails, Mode=OneWay}" Style="{StaticResource Phase1BodyTextStyle}"
                       AutomationProperties.Name="Full source attribution and notices" />
            <TextBlock Text="{x:Bind ViewModel.AiSendNotice, Mode=OneWay}" Style="{StaticResource Phase1CaptionTextStyle}" />
            <Button Content="Ask AI / Retry" Command="{x:Bind ViewModel.AskAiCommand, Mode=OneWay}" />
            <Button Content="Cancel" Command="{x:Bind ViewModel.CancelCommand, Mode=OneWay}" />
            </StackPanel>
          </Expander>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="2">
          <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowStageActions, Mode=OneWay}">
          <StackPanel Visibility="{x:Bind ViewModel.ShowBackendStatuses, Mode=OneWay}">
            <TextBlock Text="{x:Bind ViewModel.AiSendNotice, Mode=OneWay}" Style="{StaticResource Phase1CaptionTextStyle}" />
            <Button Content="Ask AI" Command="{x:Bind ViewModel.AskAiCommand, Mode=OneWay}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.IsAiErrorPreview, Mode=OneWay}">
            <Button Command="{x:Bind ViewModel.AskAiCommand, Mode=OneWay}" Style="{StaticResource Phase1ActionButtonStyle}">
              <StackPanel Orientation="Horizontal" Spacing="8"><BitmapIcon Style="{StaticResource Phase1RetryIconStyle}" /><TextBlock Text="Ask AI / Retry" /></StackPanel>
            </Button>
            <Button Content="Close" Command="{x:Bind ViewModel.CloseCommand, Mode=OneWay}" Style="{StaticResource Phase1ActionButtonStyle}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.IsOcrErrorPreview, Mode=OneWay}">
            <Button Command="{x:Bind ViewModel.SelectAgainCommand, Mode=OneWay}" Style="{StaticResource Phase1PrimaryButtonStyle}">
              <StackPanel Orientation="Horizontal" Spacing="8"><BitmapIcon Style="{StaticResource Phase1ScanIconStyle}" Foreground="{ThemeResource Phase1OnAccentBrush}" /><TextBlock Text="Select again" /></StackPanel>
            </Button>
            <Button Content="Close" Command="{x:Bind ViewModel.CloseCommand, Mode=OneWay}" Style="{StaticResource Phase1ActionButtonStyle}" />
          </StackPanel>
          <Button Width="112" HorizontalAlignment="Left" Command="{x:Bind ViewModel.CancelCommand, Mode=OneWay}" Style="{StaticResource Phase1ActionButtonStyle}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" AutomationProperties.Name="Cancel">
            <StackPanel Orientation="Horizontal" Spacing="8"><BitmapIcon Style="{StaticResource Phase1CloseIconStyle}" /><TextBlock Text="Cancel" /></StackPanel>
          </Button>
          </StackPanel>
        <StackPanel x:Name="ActionButtons" Orientation="Horizontal" Spacing="{StaticResource Phase1Space8}"
                    Visibility="{x:Bind ViewModel.ShowResultActions, Mode=OneWay}"
                    SizeChanged="ActionButtons_SizeChanged">
          <Button x:Name="SaveButton" Width="136" MinWidth="0" Style="{StaticResource Phase1PrimaryButtonStyle}"
                  Command="{x:Bind ViewModel.SaveCommand, Mode=OneWay}"
                  ToolTipService.ToolTip="{x:Bind ViewModel.UnavailableActionsReason, Mode=OneWay}"
                  HorizontalAlignment="Stretch" AutomationProperties.Name="Save phrase (preview only; production unavailable)">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Phase1Space8}">
              <BitmapIcon Style="{StaticResource Phase1BookmarkIconStyle}" Foreground="{ThemeResource Phase1OnAccentBrush}" Visibility="{x:Bind ViewModel.IsNotPreviewSaved, Mode=OneWay}" />
              <BitmapIcon Style="{StaticResource Phase1CheckIconStyle}" Visibility="{x:Bind ViewModel.IsPreviewSaved, Mode=OneWay}" />
              <TextBlock Text="{x:Bind ViewModel.SaveButtonText, Mode=OneWay}" />
            </StackPanel>
          </Button>
          <Button x:Name="ExplainButton" Width="112" MinWidth="0" Style="{StaticResource Phase1ActionButtonStyle}"
                  Command="{x:Bind ViewModel.ToggleExpansionCommand, Mode=OneWay}"
                  HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Bind ViewModel.ExplainAutomationName, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Phase1Space8}">
              <BitmapIcon Style="{StaticResource Phase1ChevronDownIconStyle}" Visibility="{x:Bind ViewModel.IsCollapsed, Mode=OneWay}" />
              <BitmapIcon Style="{StaticResource Phase1ChevronUpIconStyle}" Visibility="{x:Bind ViewModel.IsExpanded, Mode=OneWay}" />
              <TextBlock Text="{x:Bind ViewModel.ExplainButtonText, Mode=OneWay}" />
            </StackPanel>
          </Button>
          <Button x:Name="CopyButton" Width="84" MinWidth="0" Style="{StaticResource Phase1GhostButtonStyle}"
                  Command="{x:Bind ViewModel.CopyCommand, Mode=OneWay}"
                  HorizontalAlignment="Stretch" AutomationProperties.Name="Copy current output">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Phase1Space8}">
              <BitmapIcon Style="{StaticResource Phase1CopyIconStyle}" />
              <TextBlock Text="Copy" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
      <Border x:Name="FeedbackStatus" Grid.Row="3" Margin="0,8,0,0" Style="{StaticResource Phase1StatusStyle}"
              Visibility="{x:Bind ViewModel.HasFeedbackStrip, Mode=OneWay}">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Grid>
          <BitmapIcon Style="{StaticResource Phase1CheckIconStyle}" Visibility="{x:Bind ViewModel.IsSuccessFeedback, Mode=OneWay}" Foreground="{ThemeResource Phase1SuccessBrush}" />
          <BitmapIcon Style="{StaticResource Phase1ErrorIconStyle}" Visibility="{x:Bind ViewModel.IsErrorStatus, Mode=OneWay}" Foreground="{ThemeResource Phase1ErrorBrush}" />
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="CopyFeedbackText" Text="{x:Bind ViewModel.CopyFeedback, Mode=OneWay}" Style="{StaticResource Phase1CaptionTextStyle}" AutomationProperties.LiveSetting="Polite" />
          <TextBlock x:Name="SaveFeedbackText" Text="{x:Bind ViewModel.SaveFeedback, Mode=OneWay}" Style="{StaticResource Phase1CaptionTextStyle}" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
          <Button Grid.Column="2" Content="Undo" Padding="0" MinWidth="0" MinHeight="0" Style="{StaticResource Phase1GhostButtonStyle}" Command="{x:Bind ViewModel.UndoCommand, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsPreviewSaved, Mode=OneWay}" AutomationProperties.Name="Undo simulated save; no storage is used" />
          <Button Grid.Column="2" Content="Retry" Padding="0" MinWidth="0" MinHeight="0" Style="{StaticResource Phase1GhostButtonStyle}" Command="{x:Bind ViewModel.SaveCommand, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsSaveErrorPreview, Mode=OneWay}" AutomationProperties.Name="Retry simulated save; no storage is used" />
        </Grid>
      </Border>
      <TextBlock Grid.Row="3" Margin="0,8,0,0" Text="{x:Bind ViewModel.SaveFeedback, Mode=OneWay}" Style="{StaticResource Phase1CaptionTextStyle}" Visibility="{x:Bind ViewModel.IsPreviewSaving, Mode=OneWay}" />
      <Grid Grid.Row="4" Margin="0,12,0,0" RowSpacing="{StaticResource Phase1Space8}"
            Visibility="{x:Bind ViewModel.IsExpanded, Mode=OneWay}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Height="1" Background="{ThemeResource Phase1BorderBrush}" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="{StaticResource Phase1Space8}">
            <TextBlock Text="{x:Bind ViewModel.ExpandedTitle, Mode=OneWay}" Style="{StaticResource Phase1TitleTextStyle}" />
            <TextBlock Text="{x:Bind ViewModel.ExpandedText, Mode=OneWay}" Style="{StaticResource Phase1BodyTextStyle}"
                       AutomationProperties.Name="Provided explanation and learning details" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
        <TextBlock Grid.Row="5" Margin="0,8,0,0" Text="{x:Bind ViewModel.FooterNotice, Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowFooter, Mode=OneWay}"
                   ToolTipService.ToolTip="{x:Bind ViewModel.UnavailableActionsReason, Mode=OneWay}"
                   Style="{StaticResource Phase1CaptionTextStyle}" />
    </Grid>
  </Border>
</UserControl>
