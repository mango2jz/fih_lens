<UserControl x:Class="FihLens.WinUI.Views.DictionaryCards"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FihLens.WinUI.ViewModels">
  <ItemsControl ItemsSource="{x:Bind Items, Mode=OneWay}">
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="vm:DictionaryCardViewModel">
        <StackPanel Spacing="4" Margin="0,8">
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind Headword}" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            <Button Grid.Column="1" Command="{x:Bind Pronunciation.SpeakCommand}" CommandParameter="{x:Bind SpeechText}"
                    AutomationProperties.Name="{x:Bind SpeechAutomationName}" ToolTipService.ToolTip="{x:Bind SpeechUnavailableReason}">
              <SymbolIcon Symbol="Volume"/>
            </Button>
          </Grid>
          <TextBlock Text="{x:Bind WrittenFormsText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.Name="Applicable written forms and usage labels"/>
          <TextBlock Text="{x:Bind ReadingsText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.Name="Dictionary readings"/>
          <TextBlock Text="{x:Bind PartOfSpeech}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
          <TextBlock Text="{x:Bind SensesText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.Name="Sourced dictionary senses"/>
          <TextBlock Text="{x:Bind Example}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
          <TextBlock Text="{x:Bind SpeechUnavailableReason}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
          <TextBlock Text="{x:Bind Provenance}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Opacity="0.75"/>
        </StackPanel>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
