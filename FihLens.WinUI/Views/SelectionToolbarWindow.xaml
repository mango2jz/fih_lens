<Window
    x:Class="FihLens.WinUI.Views.SelectionToolbarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Capture toolbar (screens/capture-toolbar): status, display, size, then Create, Cancel and Translate. -->
    <Grid Background="{ThemeResource Phase1BarBrush}">
        <Grid x:Name="ToolbarRoot" Padding="14,6,6,6" ColumnSpacing="{StaticResource Phase1Space8}"
              AutomationProperties.Name="Region capture"
              AutomationProperties.HelpText="Space creates a region. Arrows move it; Shift and arrows resize it. Enter translates; Escape cancels.">
            <Grid.Resources>
                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Path Style="{StaticResource Phase1StrokeIconStyle}" Stroke="{ThemeResource Phase1KoiInkBrush}" VerticalAlignment="Center"
                  Data="M3 7V3H7M13 3H17V7M17 13V17H13M7 17H3V13M6 10H14" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       Style="{StaticResource Phase1LabelTextStyle}" TextWrapping="NoWrap" IsTextSelectionEnabled="False"
                       ToolTipService.ToolTip="{x:Bind ViewModel.Status, Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
            <Border Grid.Column="2" Width="1" Height="20" Background="{ThemeResource Phase1LineBrush}" VerticalAlignment="Center" />
            <Border Grid.Column="3" Height="30" Padding="10,0" CornerRadius="15" Background="{ThemeResource Phase1BarRaisedBrush}"
                    VerticalAlignment="Center" ToolTipService.ToolTip="Display to capture. Change it in Settings.">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Path Style="{StaticResource Phase1StrokeIconStyle}" Stroke="{ThemeResource Phase1InkMutedBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"
                          Data="M3 4H17V13H3V4ZM7 16.5H13M10 13V16.5" />
                    <TextBlock Text="{x:Bind ViewModel.DisplayLabel}" Style="{StaticResource Phase1CaptionTextStyle}" FontWeight="SemiBold"
                               Foreground="{ThemeResource Phase1InkBrush}" VerticalAlignment="Center" IsTextSelectionEnabled="False" />
                </StackPanel>
            </Border>
            <TextBlock Grid.Column="4" Text="{x:Bind ViewModel.Dimensions, Mode=OneWay}" VerticalAlignment="Center" FontFamily="{StaticResource Phase1MonoFontFamily}"
                       FontSize="{StaticResource Phase1KeyFontSize}" FontWeight="SemiBold" Foreground="{ThemeResource Phase1InkMutedBrush}" TextWrapping="NoWrap"
                       AutomationProperties.Name="Selected region size" />
            <Button Grid.Column="5" x:Name="CreateButton" Click="Create_Click" Style="{StaticResource Phase1GhostButtonStyle}" MinHeight="30" Padding="10,0"
                    CornerRadius="15" AutomationProperties.Name="Create region"
                    AutomationProperties.HelpText="Space creates a region. Arrows move it; Shift and arrows resize it.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Create" VerticalAlignment="Center" />
                    <ContentControl Style="{StaticResource Phase1KeycapStyle}" Content="Space" Height="18" MinWidth="18" Padding="4,0" FontSize="10" />
                </StackPanel>
            </Button>
            <Button Grid.Column="6" Click="Cancel_Click" Style="{StaticResource Phase1GhostButtonStyle}" MinHeight="30" Padding="10,0"
                    CornerRadius="15" AutomationProperties.Name="Cancel" AutomationProperties.HelpText="Escape cancels without capturing.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Cancel" VerticalAlignment="Center" />
                    <ContentControl Style="{StaticResource Phase1KeycapStyle}" Content="Esc" Height="18" MinWidth="18" Padding="4,0" FontSize="10" />
                </StackPanel>
            </Button>
            <Button Grid.Column="7" IsEnabled="{x:Bind ViewModel.CanConfirm, Mode=OneWay}" Click="Confirm_Click" Style="{StaticResource Phase1PrimaryButtonStyle}"
                    MinHeight="30" Padding="12,0" CornerRadius="15"
                    AutomationProperties.Name="Translate" AutomationProperties.HelpText="Enter reads and translates the selected region.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Translate" VerticalAlignment="Center" />
                    <ContentControl Style="{StaticResource Phase1KeycapStyle}" Content="↵" Height="18" MinWidth="18" Padding="4,0" FontSize="10"
                                    Background="{ThemeResource Phase1OnKoiBrush}" Foreground="{ThemeResource Phase1KoiBrush}" BorderThickness="0" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
